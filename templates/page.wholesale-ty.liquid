  .lola-ty__star--21 { --star-left: 6%; --star-opacity: 0.78; --star-size: 0.45rem; --star-top: 19%; }
  .lola-ty__star--22 { --star-left: 22%; --star-opacity: 0.74; --star-size: 0.38rem; --star-top: 21%; }
  .lola-ty__star--23 { --star-left: 54%; --star-opacity: 0.75; --star-size: 0.42rem; --star-top: 19%; }
  .lola-ty__star--24 { --star-left: 84%; --star-opacity: 0.72; --star-size: 0.45rem; --star-top: 18%; }
  .lola-ty__star--25 { --star-left: 13%; --star-opacity: 0.74; --star-size: 0.36rem; --star-top: 77%; }
  .lola-ty__star--26 { --star-left: 66%; --star-opacity: 0.72; --star-size: 0.38rem; --star-top: 79%; }
  .lola-ty__star--27 { --star-left: 95%; --star-opacity: 0.68; --star-size: 0.4rem; --star-top: 76%; }

  .lola-ty__inner {
    margin: 0 auto;
    max-width: 1920px;
    min-height: clamp(32rem, 48vw, 57.5rem);
    padding: clamp(3.3rem, 7.2vw, 8.65rem) clamp(1.25rem, 4vw, 8.4rem) clamp(2.2rem, 4vw, 3.6rem);
    position: relative;
    z-index: 1;
  }

  .lola-ty__title {
    font-family: "Noto Serif Display", Georgia, "Times New Roman", serif !important;
    font-size: clamp(2.5rem, 4.6vw, 5.5rem) !important;
