  .lola-ty__star--5 { --star-fill: #fff96d; --star-left: 16%; --star-rotate: 9deg; --star-size: clamp(0.75rem, 1.2vw, 1.4rem); --star-top: 50%; }
  .lola-ty__star--6 { --star-fill: #fff96d; --star-left: 86%; --star-rotate: -10deg; --star-size: clamp(0.75rem, 1.2vw, 1.4rem); --star-top: 50%; }
  .lola-ty__star--7 { --star-fill: #61dfdd; --star-left: 27%; --star-rotate: -12deg; --star-size: clamp(0.65rem, 1.1vw, 1.25rem); --star-top: 87%; }
  .lola-ty__star--8 { --star-fill: #fff96d; --star-left: 73%; --star-rotate: -10deg; --star-size: clamp(0.65rem, 1.1vw, 1.25rem); --star-top: 87%; }
  .lola-ty__star--9 { --star-left: 8%; --star-opacity: 0.85; --star-rotate: 7deg; --star-size: clamp(1rem, 1.8vw, 1.95rem); --star-top: 1%; }
  .lola-ty__star--10 { --star-left: 48%; --star-opacity: 0.9; --star-rotate: -4deg; --star-size: clamp(1.1rem, 2.1vw, 2.4rem); --star-top: 1%; }
  .lola-ty__star--11 { --star-left: 89%; --star-opacity: 0.82; --star-rotate: 13deg; --star-size: clamp(1rem, 1.8vw, 2.05rem); --star-top: 2%; }
  .lola-ty__star--12 { --star-left: 18%; --star-opacity: 0.82; --star-rotate: 10deg; --star-size: clamp(0.8rem, 1.5vw, 1.55rem); --star-top: 14%; }
  .lola-ty__star--13 { --star-left: 31%; --star-opacity: 0.88; --star-rotate: -8deg; --star-size: clamp(0.9rem, 1.7vw, 1.85rem); --star-top: 14%; }
  .lola-ty__star--14 { --star-left: 64%; --star-opacity: 0.88; --star-rotate: 8deg; --star-size: clamp(0.9rem, 1.7vw, 1.85rem); --star-top: 13%; }
  .lola-ty__star--15 { --star-left: 72%; --star-opacity: 0.9; --star-rotate: -12deg; --star-size: clamp(0.95rem, 1.8vw, 2rem); --star-top: 18%; }
  .lola-ty__star--16 { --star-left: 3%; --star-opacity: 0.8; --star-rotate: 14deg; --star-size: clamp(0.75rem, 1.5vw, 1.55rem); --star-top: 45%; }
  .lola-ty__star--17 { --star-left: 17%; --star-opacity: 0.85; --star-rotate: -9deg; --star-size: clamp(0.95rem, 1.8vw, 2.05rem); --star-top: 61%; }
