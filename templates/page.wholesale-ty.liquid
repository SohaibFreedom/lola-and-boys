      max-width: 21rem;
      padding: 1.25rem 1rem;
      text-align: center;
    }

    .lola-ty__divider {
      height: 0.3125rem;
      width: 100%;
    }

    .lola-ty__icon {
      max-width: 4rem;
    }

    .lola-ty__star--7,
    .lola-ty__star--8,
    .lola-ty__star--11,
    .lola-ty__star--12,
    .lola-ty__star--14,
    .lola-ty__star--15,
    .lola-ty__star--16,
    .lola-ty__star--17,
    .lola-ty__star--18,
    .lola-ty__star--19,
    .lola-ty__star--20,
    .lola-ty__star--23,
    .lola-ty__star--24,
    .lola-ty__star--26,
