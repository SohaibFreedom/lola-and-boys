{% comment %}
  Lola + The Boys - Wholesale thank-you page

  Shopify install:
  1. This template uses the provided Shopify CDN icon URLs directly.
  2. Add a new page template named "wholesale-ty".
  3. Paste this file into templates/page.wholesale-ty.liquid.
  4. Assign the template to the wholesale thank-you page.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Display:wght@400&family=Nunito:wght@400;500;600;700;800&family=Sofia+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
  .lola-ty {
    --ty-pink: #ff73cb;
    --ty-pink-soft: #ffe5ef;
    --ty-lavender: #d6c7fe;
    --ty-ink: #000;
    --ty-card-shadow: 3px 4px 10.6px rgba(0, 0, 0, 0.11);
    background: var(--ty-pink-soft) url("https://cdn.shopify.com/s/files/1/0002/0647/1226/files/BG_1.png?v=1786473248") center top / cover no-repeat;
    color: var(--ty-ink) !important;
    font-family: "Sofia Pro", "Sofia Sans", "Nunito", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
    font-size: 16px !important;
    font-style: normal !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    line-height: 1.5 !important;
    min-height: 100vh;
    overflow: hidden;
    position: relative;
    text-align: center;
  }

  .lola-ty *,
  .lola-ty *::before,
  .lola-ty *::after {
    box-sizing: border-box;
  }

  .lola-ty :is(h1, h2, h3, p, a, div, span) {
    letter-spacing: 0 !important;
  }

  .lola-ty__inner {
    margin: 0 auto;
    max-width: 1920px;
    min-height: clamp(58rem, 103.54vw, 124.25rem);
    padding: clamp(7.5rem, 18.39vw, 22.0625rem) clamp(1.25rem, 4vw, 8.4rem) clamp(4rem, 10vw, 7.75rem);
    position: relative;
    z-index: 1;
  }

  .lola-ty__title {
    font-family: "Noto Serif Display", Georgia, "Times New Roman", serif !important;
    font-size: 216px !important;
    font-style: normal !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    line-height: 0.44 !important;
    margin: 0 !important;
    text-transform: none !important;
    white-space: nowrap;
    color: #000 !important;
  }

  .lola-ty__received {
    color: var(--ty-pink) !important;
    font-family: "Sofia Pro", "Sofia Sans", "Nunito", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
    font-size: 53px !important;
    font-style: normal !important;
    font-weight: 500 !important;
    letter-spacing: 0.015em !important;
    line-height: 0.82 !important;
    margin: clamp(3.1rem, 7.65vw, 9.2rem) 0 0 !important;
    text-transform: uppercase !important;
  }

  .lola-ty__rule {
    background: var(--ty-pink);
    height: 0.3125rem;
    margin: clamp(2.25rem, 4.48vw, 5.375rem) auto 0;
    width: clamp(12rem, 25.1vw, 30.125rem);
  }

  .lola-ty__message {
    font-family: "Sofia Pro", "Sofia Sans", "Nunito", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
    font-size: 48px !important;
    font-style: normal !important;
    font-weight: 400 !important;
    line-height: 1.4 !important;
    margin: clamp(2.6rem, 4.53vw, 5.4375rem) auto 0 !important;
    max-width: 60.25rem;
    text-transform: none !important;
  }

  .lola-ty__card {
    align-items: center;
    background: #fff;
    border-radius: 1.8125rem;
    box-shadow: var(--ty-card-shadow);
    display: grid;
    gap: clamp(1.5rem, 3.5vw, 4.25rem);
    grid-template-columns: 15.5rem minmax(18rem, 1fr) 0.3125rem 14rem minmax(18rem, 1fr);
    margin: clamp(4.3rem, 7.03vw, 8.4375rem) auto 0;
    max-width: 103.3125rem;
    min-height: clamp(13rem, 20.52vw, 24.625rem);
    padding: clamp(2rem, 4.2vw, 4.5rem) clamp(2rem, 4.5vw, 6.5rem);
    text-align: left;
  }

  .lola-ty__card > div {
    min-width: 0;
  }

  .lola-ty__icon {
    display: block;
    height: auto;
    justify-self: center;
    max-width: 13.125rem;
    width: 100%;
  }

  .lola-ty__divider {
    background: rgba(255, 115, 203, 0.3);
    height: clamp(9rem, 13.9vw, 16.6875rem);
    width: 0.3125rem;
  }

  .lola-ty__card h2 {
    color: var(--ty-ink) !important;
    font-family: "Sofia Pro", "Sofia Sans", "Nunito", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
    font-size: 44px !important;
    font-style: normal !important;
    font-weight: 700 !important;
    letter-spacing: 0 !important;
    line-height: 0.98 !important;
    margin: 0 0 0.7rem !important;
    text-transform: none !important;
  }

  .lola-ty__card p {
    color: var(--ty-ink) !important;
    font-family: "Sofia Pro", "Sofia Sans", "Nunito", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
    font-size: 26px !important;
    font-style: normal !important;
    font-weight: 400 !important;
    line-height: 1.633 !important;
    margin: 0 !important;
    text-transform: none !important;
  }

  .lola-ty__card a {
    color: var(--ty-pink) !important;
    font-family: "Sofia Pro", "Sofia Sans", "Nunito", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
    font-size: 22px !important;
    font-weight: inherit !important;
    line-height: inherit !important;
    overflow-wrap: normal !important;
    text-decoration: underline !important;
    text-underline-offset: 0.08em !important;
    white-space: nowrap !important;
    word-break: normal !important;
  }

  .lola-ty__brand {
    color: var(--ty-pink) !important;
    font-family: "Noto Serif Display", Georgia, "Times New Roman", serif !important;
    font-size: 70px !important;
    font-style: normal !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    line-height: 1.375 !important;
    margin: clamp(3.6rem, 6.2vw, 7.4375rem) 0 0 !important;
    text-transform: none !important;
    white-space: nowrap !important;
  }

  .lola-ty__brand-row {
    align-items: center;
    display: flex;
    flex-wrap: nowrap;
    gap: 2.25rem;
    justify-content: center;
  }

  .lola-ty__brand-star {
    aspect-ratio: 1;
    background: #000;
    clip-path: polygon(50% 0%, 62% 33%, 98% 35%, 69% 56%, 79% 91%, 50% 70%, 21% 91%, 31% 56%, 2% 35%, 38% 33%);
    display: inline-block;
    flex: 0 0 auto;
    position: relative;
    transform: rotate(-12deg);
    width: 3rem;
  }

  .lola-ty__brand-star::after {
    background: var(--star-fill);
    clip-path: inherit;
    content: "";
    inset: 0.16rem;
    position: absolute;
  }

  .lola-ty__brand-star--left {
    --star-fill: #61dfdd;
  }

  .lola-ty__brand-star--right {
    --star-fill: #fff96d;
    transform: rotate(12deg);
  }

  .lola-ty__closing {
    color: var(--ty-ink) !important;
    font-family: "Sofia Pro", "Sofia Sans", "Nunito", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
    font-size: 31px !important;
    font-style: normal !important;
    font-weight: 400 !important;
    line-height: 1.46 !important;
    margin: 0.35rem auto 0 !important;
    max-width: 39.0625rem;
    text-transform: none !important;
  }

  @media (max-width: 900px) {
    .lola-ty__inner {
      min-height: 56rem;
      padding-top: 7.5rem;
    }

    .lola-ty__title {
      font-size: 76px !important;
    }

    .lola-ty__received {
      font-size: 28px !important;
      line-height: 1.08 !important;
      margin-top: 3.4rem !important;
    }

    .lola-ty__message {
      font-size: 30px !important;
      max-width: 35rem;
    }

    .lola-ty__card {
      grid-template-columns: 1fr;
      max-width: 37rem;
      padding: 2.5rem 2rem;
      text-align: center;
    }

    .lola-ty__divider {
      height: 0.3125rem;
      width: 100%;
    }

    .lola-ty__icon {
      max-width: 8.5rem;
    }

    .lola-ty__card h2 {
      font-size: 32px !important;
    }

    .lola-ty__card p {
      font-size: 22px !important;
    }

    .lola-ty__card a {
      font-size: 20px !important;
      white-space: normal !important;
    }

    .lola-ty__brand {
      font-size: 48px !important;
    }

    .lola-ty__brand-row {
      gap: 1.3rem;
    }

    .lola-ty__brand-star {
      width: 2.1rem;
    }

    .lola-ty__closing {
      font-size: 24px !important;
    }

  }

  @media (max-width: 560px) {
    .lola-ty__inner {
      min-height: 52rem;
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .lola-ty__title {
      font-size: 64px !important;
    }

    .lola-ty__received {
      font-size: 20px !important;
    }

    .lola-ty__message {
      font-size: 22px !important;
    }

    .lola-ty__card h2 {
      font-size: 28px !important;
    }

    .lola-ty__card p {
      font-size: 18px !important;
    }

    .lola-ty__card a {
      font-size: 16px !important;
      white-space: normal !important;
    }

    .lola-ty__brand {
      font-size: 32px !important;
    }

    .lola-ty__brand-row {
      gap: 0.55rem;
    }

    .lola-ty__brand-star {
      width: 1.2rem;
    }

    .lola-ty__closing {
      font-size: 18px !important;
    }
  }
</style>

<section class="lola-ty">
  <div class="lola-ty__inner">
    <h1 class="lola-ty__title">Thank You!</h1>
    <p class="lola-ty__received">Your application has been received.</p>
    <div class="lola-ty__rule" aria-hidden="true"></div>

    <p class="lola-ty__message">
      We&rsquo;re excited to connect with you and<br>
      explore how we can grow together.
    </p>

    <div class="lola-ty__card">
      <img class="lola-ty__icon" src="https://cdn.shopify.com/s/files/1/0002/0647/1226/files/image_136.png?v=1786471832" alt="">

      <div>
        <h2>We&rsquo;ll be in touch</h2>
        <p>Our team will review your<br>information and reach out<br>if there&rsquo;s a great fit!</p>
      </div>

      <div class="lola-ty__divider" aria-hidden="true"></div>

      <img class="lola-ty__icon" src="https://cdn.shopify.com/s/files/1/0002/0647/1226/files/image_138.png?v=1786471832" alt="">

      <div>
        <h2>Questions?</h2>
        <p>
          Email us at<br>
          <a href="mailto:james@lolaandtheboys.com">james@lolaandtheboys.com</a><br>
          <a href="mailto:nichole@lolaandtheboys.com">nichole@lolaandtheboys.com</a>
        </p>
      </div>
    </div>

    <div class="lola-ty__brand-row">
      <span class="lola-ty__brand-star lola-ty__brand-star--left" aria-hidden="true"></span>
      <div class="lola-ty__brand">Lola + The Boys</div>
      <span class="lola-ty__brand-star lola-ty__brand-star--right" aria-hidden="true"></span>
    </div>
    <p class="lola-ty__closing">
      Premium styles for the next generation.<br>
      We can&rsquo;t wait to grow together!
    </p>
  </div>
</section>
