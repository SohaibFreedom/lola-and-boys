      radial-gradient(circle at 12% 72%, rgba(255, 255, 255, 0.82) 0 0.32rem, transparent 0.35rem),
      radial-gradient(circle at 76% 14%, rgba(255, 255, 255, 0.78) 0 0.28rem, transparent 0.31rem),
