    .lola-ty__star--1 { --star-left: 9%; --star-top: 7%; }
    .lola-ty__star--2 { --star-left: 82%; --star-top: 7%; }
    .lola-ty__star--3 { --star-left: 6%; --star-top: 25%; }
    .lola-ty__star--4 { --star-left: 84%; --star-top: 25%; }
