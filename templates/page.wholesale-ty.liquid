  .lola-ty *::after {
    box-sizing: border-box;
  }

  .lola-ty :is(h1, h2, h3, p, a, div, span) {
    letter-spacing: 0 !important;
  }

  .lola-ty__stars {
    inset: 0;
    pointer-events: none;
    position: absolute;
    z-index: 0;
  }

  .lola-ty__star {
    aspect-ratio: 1;
    background: var(--star-fill, #fff);
    clip-path: polygon(50% 0%, 62% 33%, 98% 35%, 69% 56%, 79% 91%, 50% 70%, 21% 91%, 31% 56%, 2% 35%, 38% 33%);
    filter: drop-shadow(0 0.08rem 0 rgba(0, 0, 0, 0.28));
    left: var(--star-left);
    opacity: var(--star-opacity, 1);
    position: absolute;
    top: var(--star-top);
    transform: rotate(var(--star-rotate, 0deg));
    width: var(--star-size, 2rem);
  }

  .lola-ty__star--outline {
    background: #000;
  }

  .lola-ty__star--outline::after {
    background: var(--star-fill, #fff);
    clip-path: inherit;
    content: "";
    inset: max(2px, calc(var(--star-size, 2rem) * 0.07));
    position: absolute;
  }

  .lola-ty__star--white {
    filter: none;
  }

  .lola-ty__star--tiny {
    border-radius: 50%;
    clip-path: none;
    filter: none;
  }

