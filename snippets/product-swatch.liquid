{% comment %}
  Set the extension of your color files below. Use 'png', 'jpeg', 'jpg' or 'gif'.
{% endcomment %}

{% assign file_extension = 'png' %}

{% assign swatch = product-swatch %}
{% assign found_option = false %}
{% assign is_color = false %}
{% assign option_index = 0 %}

{% for option in product.options %}
  {% if option == swatch %}
    {% assign found_option = true %}
    {% assign option_index = forloop.index0 %}
    {% assign downcased_option = swatch | downcase %}
    {% if downcased_option contains 'color' or downcased_option contains 'colour' %}
      {% assign is_color = true %}
    {% endif %}
  {% endif %}
{% endfor %}

{%- assign product_option = product.options_with_values[option_index] -%}

<div class="swatch clearfix{% if downcased_option contains 'size' %} product-size-swatch{% endif %}" data-option-index="{{ option_index }}" data-option-name="{{ swatch | escape }}">
  <div class="option_title">{{ swatch }}</div>
  {% if downcased_option contains 'size' %}
    <div class="product-size-error-box">
  {% endif %}
  {% assign values = '' %}
  {% assign swatch_checked = false %}
  {% for variant in product.variants %}
    {% assign value = variant.options[option_index] %}
    {% unless values contains value %}
      {% assign values = values | join: ',' %}
      {% assign values = values | append: ',' | append: value %}
      {% assign values = values | split: ',' %}
      {% assign swatch_color_override = variant.metafields.custom.swatch_color_override.value | default: variant.metafields.custom.swatch_color_override %}

      {%- comment -%} Pull color/image from Shopify Color metaobject (option_value.swatch) {%- endcomment -%}
      {%- assign metaobject_hex = nil -%}
      {%- assign metaobject_image = nil -%}
      {%- if product_option and product_option.values -%}
        {%- for ov in product_option.values -%}
          {%- if ov.name == value -%}
            {%- assign metaobject_hex = ov.swatch.color -%}
            {%- assign metaobject_image = ov.swatch.image -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {% assign check_this_swatch = false %}
      {% if swatch_checked == false %}
        {% assign check_this_swatch = true %}
        {% assign swatch_checked = true %}
      {% endif %}

      <input id="swatch-{{ option_index }}-{{ value | handle }}-{{ product.id }}" type="radio" name="option-{{ option_index }}" value="{{ value | escape }}"{% unless downcased_option contains 'size' %}{% if check_this_swatch %} checked{% endif %}{% endunless %} />
      <div data-value="{{ value | escape }}" class="swatch-element {% if is_color %}color {% endif %}{{ value | handle }}-swatch {% if variant.available %}available{% else %}soldout{% endif %}">
        {% if is_color %}
          <div class="tooltip">{{ value }}</div>
        {% endif %}
        {% if is_color %}
          <label for="swatch-{{ option_index }}-{{ value | handle }}-{{ product.id }}" style="
            {%- if swatch_color_override != blank -%}
              background-image: none; background-color: {{ swatch_color_override | escape }};
            {%- elsif metaobject_image != blank -%}
              background-image: url({{ metaobject_image | image_url: width: 50 }}); background-color: {{ metaobject_hex | default: 'transparent' }};
            {%- elsif metaobject_hex != blank -%}
              background-image: none; background-color: {{ metaobject_hex }};
            {%- else -%}
              background-image: url({{ value | handle | append: '.' | append: file_extension | asset_img_url: '50x' | prepend: 'https:' }}); background-color: {{ value | split: ' ' | last | handle }};
            {%- endif -%}
          ">
            <span class="crossed-out"></span>
          </label>
        {% else %}
          <label for="swatch-{{ option_index }}-{{ value | handle }}-{{ product.id }}">
            {{ value }}
            <span class="crossed-out"></span>
          </label>
        {% endif %}
      </div>
    {% endunless %}
  {% endfor %}
  {% if downcased_option contains 'size' %}
    </div>
    <div class="product-size-required-message" aria-live="polite">Please select a size</div>
  {% endif %}
</div>
